; MembridgePhys - minimal WDM physical memory provider
; NOTE: this INF installs an unsigned service. Under HVCI the .sys must be
; Microsoft-signed (WHQL/attestation) before it can load.
[Version]
Signature="$WINDOWS NT$"
Class=System
ClassGuid={4D36E97D-E325-11CE-BFC1-08002BE10318}
Provider=%Provider%
DriverVer=11/22/2026,1.0.0.0
CatalogFile=MembridgePhys.cat

[DestinationDirs]
DefaultDestDir = 12

[SourceDisksNames]
1 = %DiskName%,,,""

[SourceDisksFiles]
MembridgePhys.sys = 1,,

[DefaultInstall]
CopyFiles = MembridgePhys.CopyFiles

[MembridgePhys.CopyFiles]
MembridgePhys.sys

[DefaultInstall.Services]
AddService = MembridgePhys,,MembridgePhys.Service

[MembridgePhys.Service]
DisplayName    = %ServiceName%
ServiceType    = 1
StartType      = 3
ErrorControl   = 1
ServiceBinary  = %12%\MembridgePhys.sys

[Strings]
Provider      = "Membridge"
DiskName      = "MembridgePhys Installation"
ServiceName   = "MembridgePhys physical memory provider"
